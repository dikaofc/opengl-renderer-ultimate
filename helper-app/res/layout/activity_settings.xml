<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenGL Renderer Ultimate"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure module settings"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:paddingBottom="16dp" />

        <!-- ======== CPU SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="CPU Configuration" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="CPU Governor" />
                <Spinner android:id="@+id/spinner_cpu_gov" style="@style/SettingSpinner"
                    android:entries="@array/governors" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Lock Governor" />
                <Switch android:id="@+id/switch_gov_lock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Max Frequency (kHz)" />
                <EditText android:id="@+id/edit_cpu_max" style="@style/SettingInput"
                    android:hint="Auto" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Min Frequency (kHz)" />
                <EditText android:id="@+id/edit_cpu_min" style="@style/SettingInput"
                    android:hint="Auto" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Input Boost Freq (0=off)" />
                <EditText android:id="@+id/edit_input_boost" style="@style/SettingInput"
                    android:text="0" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Boost Duration (ms)" />
                <EditText android:id="@+id/edit_boost_ms" style="@style/SettingInput"
                    android:text="50" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== GPU SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="GPU Configuration" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="GPU Governor" />
                <Spinner android:id="@+id/spinner_gpu_gov" style="@style/SettingSpinner"
                    android:entries="@array/gpu_governors" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="GPU Overclock" />
                <Switch android:id="@+id/switch_gpu_oc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Max GPU Freq (Hz)" />
                <EditText android:id="@+id/edit_gpu_max" style="@style/SettingInput"
                    android:hint="Auto" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Force Clock On" />
                <Switch android:id="@+id/switch_force_clk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Force Bus On" />
                <Switch android:id="@+id/switch_force_bus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Idle Timer (ms)" />
                <EditText android:id="@+id/edit_idle_timer" style="@style/SettingInput"
                    android:text="50" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== RAM SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="RAM &amp; Memory" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Swappiness (0-200)" />
                <EditText android:id="@+id/edit_swappiness" style="@style/SettingInput"
                    android:text="100" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Dirty Ratio (%)" />
                <EditText android:id="@+id/edit_dirty_ratio" style="@style/SettingInput"
                    android:text="40" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Dirty Background (%)" />
                <EditText android:id="@+id/edit_dirty_bg" style="@style/SettingInput"
                    android:text="10" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="VFS Cache Pressure" />
                <EditText android:id="@+id/edit_vfs_cache" style="@style/SettingInput"
                    android:text="50" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Min Free KBytes" />
                <EditText android:id="@+id/edit_min_free" style="@style/SettingInput"
                    android:text="12288" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="I/O Scheduler" />
                <Spinner android:id="@+id/spinner_io_sched" style="@style/SettingSpinner"
                    android:entries="@array/io_schedulers" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Readahead (KB)" />
                <EditText android:id="@+id/edit_readahead" style="@style/SettingInput"
                    android:text="2048" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="ZRAM Size (0=auto)" />
                <EditText android:id="@+id/edit_zram" style="@style/SettingInput"
                    android:hint="Auto" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== NETWORK SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="Network Configuration" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="TCP Congestion" />
                <Spinner android:id="@+id/spinner_tcp" style="@style/SettingSpinner"
                    android:entries="@array/tcp_congestions" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Queue Discipline" />
                <Spinner android:id="@+id/spinner_qdisc" style="@style/SettingSpinner"
                    android:entries="@array/qdiscs" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="TCP FastOpen" />
                <Spinner android:id="@+id/spinner_fastopen" style="@style/SettingSpinner"
                    android:entries="@array/fastopen_values" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="MTU Probing" />
                <Switch android:id="@+id/switch_mtu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Somaxconn" />
                <EditText android:id="@+id/edit_somaxconn" style="@style/SettingInput"
                    android:text="4096" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== THERMAL SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="Thermal Management" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Thermal Mode" />
                <Spinner android:id="@+id/spinner_thermal" style="@style/SettingSpinner"
                    android:entries="@array/thermal_modes" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="CPU Throttle (mC)" />
                <EditText android:id="@+id/edit_cpu_throttle" style="@style/SettingInput"
                    android:text="95000" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="GPU Throttle (mC)" />
                <EditText android:id="@+id/edit_gpu_throttle" style="@style/SettingInput"
                    android:text="95000" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Polling (ms)" />
                <EditText android:id="@+id/edit_polling" style="@style/SettingInput"
                    android:text="2000" android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== OPENGL SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="OpenGL Renderer" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="HWUI Renderer" />
                <Spinner android:id="@+id/spinner_renderer" style="@style/SettingSpinner"
                    android:entries="@array/renderers" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="RenderEngine" />
                <Spinner android:id="@+id/spinner_re" style="@style/SettingSpinner"
                    android:entries="@array/renderers" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="CPU Time Budget (%)" />
                <EditText android:id="@+id/edit_hwui_cpu" style="@style/SettingInput"
                    android:text="25" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Texture Cache (MB)" />
                <EditText android:id="@+id/edit_tex_cache" style="@style/SettingInput"
                    android:text="96" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Layer Cache (MB)" />
                <EditText android:id="@+id/edit_layer_cache" style="@style/SettingInput"
                    android:text="48" android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Frame Pacing" />
                <Switch android:id="@+id/switch_frame_pacing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Multi-threaded Pipeline" />
                <Switch android:id="@+id/switch_multi_thread" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== ANIMATION SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="Animation Scale" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Window Animation" />
                <Spinner android:id="@+id/spinner_win_anim" style="@style/SettingSpinner"
                    android:entries="@array/anim_scales" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Transition Animation" />
                <Spinner android:id="@+id/spinner_trans_anim" style="@style/SettingSpinner"
                    android:entries="@array/anim_scales" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Animator Duration" />
                <Spinner android:id="@+id/spinner_anim_dur" style="@style/SettingSpinner"
                    android:entries="@array/anim_scales" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== KERNEL SECTION ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/card_bg"
            android:padding="0dp" android:layout_marginBottom="12dp">

            <TextView style="@style/SectionHeader" android:text="Kernel Settings" />

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Sched Autogroup" />
                <Switch android:id="@+id/switch_autogroup" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Child Runs First" />
                <Switch android:id="@+id/switch_child_runs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="Fsync" />
                <Switch android:id="@+id/switch_fsync" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="BPF JIT" />
                <Switch android:id="@+id/switch_bpf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <TextView style="@style/SettingLabel" android:text="SysRq" />
                <Switch android:id="@+id/switch_sysrq" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======== ACTION BUTTONS ======== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">

            <Button android:id="@+id/btn_apply" style="@style/ActionButton"
                android:text="Apply All" android:layout_marginRight="6dp" />
            <Button android:id="@+id/btn_save" style="@style/ActionButton"
                android:text="Save Config" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">

            <Button android:id="@+id/btn_reset" style="@style/ActionButton"
                android:text="Reset Defaults" android:layout_marginRight="6dp" />
            <Button android:id="@+id/btn_reboot" style="@style/DangerButton"
                android:text="Reboot" />
        </LinearLayout>

        <!-- Status -->
        <TextView android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:textAlignment="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

    </LinearLayout>
</ScrollView>
